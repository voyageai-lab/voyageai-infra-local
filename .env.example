# Docker Compose environment variables
# Copy this file to .env and fill in your real keys:
#   cp .env.example .env

OPENAI_API_KEY=sk-your-openai-api-key
JWT_SECRET=your-jwt-secret-at-least-32-chars-long
MYSQL_ROOT_PASSWORD=voyageai123

# Foursquare Places API (free tier)
# Get key at: https://foursquare.com/developers/
FOURSQUARE_API_KEY=your-foursquare-api-key

# Amadeus Flight/Hotel API (free test environment)
# Get keys at: https://developers.amadeus.com/
AMADEUS_API_KEY=your-amadeus-api-key
AMADEUS_API_SECRET=your-amadeus-api-secret

# Google Maps API (Places, Directions, Geocoding)
# Get key at: https://console.cloud.google.com/
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
